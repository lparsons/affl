#!/usr/bin/env sh
# AFFL Git Pre-Commit Hook
# Validates Markdown formatting and Ruby code before committing.

# Get list of staged markdown files
STAGED_MD_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)

if [ -n "$STAGED_MD_FILES" ]; then
  echo "🔍 Linting staged Markdown files with markdownlint..."
  if ! npx --yes markdownlint-cli $STAGED_MD_FILES; then
    echo ""
    echo "❌ Markdown lint errors found. Please fix them before committing."
    echo "💡 Tip: Run 'npx markdownlint-cli --fix <file>' to automatically fix spacing and formatting."
    exit 1
  fi
  echo "✅ Markdown lint passed!"
fi

# Get list of staged Ruby files
STAGED_RB_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rb$' || true)

if [ -n "$STAGED_RB_FILES" ]; then
  # Include standard Ruby path if not present in inherited session PATH
  if ! command -v rubocop >/dev/null 2>&1; then
    if [ -d "/c/Ruby32-x64/bin" ]; then
      export PATH="/c/Ruby32-x64/bin:$PATH"
    elif [ -d "C:/Ruby32-x64/bin" ]; then
      export PATH="C:/Ruby32-x64/bin:$PATH"
    fi
  fi

  if command -v rubocop >/dev/null 2>&1; then
    echo "🔍 Linting staged Ruby files with RuboCop..."
    if ! rubocop $STAGED_RB_FILES; then
      echo ""
      echo "❌ RuboCop lint errors found. Please fix them before committing."
      exit 1
    fi
    echo "✅ RuboCop lint passed!"
  elif command -v bundle >/dev/null 2>&1 && bundle exec rubocop -v >/dev/null 2>&1; then
    echo "🔍 Linting staged Ruby files with bundle exec rubocop..."
    if ! bundle exec rubocop $STAGED_RB_FILES; then
      echo ""
      echo "❌ RuboCop lint errors found. Please fix them before committing."
      exit 1
    fi
    echo "✅ RuboCop lint passed!"
  else
    echo "ℹ️  RuboCop not installed locally; skipping local Ruby lint (validated in CI)."
  fi
fi

exit 0
